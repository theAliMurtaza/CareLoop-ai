{
  "id": "careloop4demo",
  "name": "CareLoop · weekly",
  "active": false,
  "nodes": [
    {
      "id": "0f4a9e26-d7f2-4dc9-ad14-a0392d2e9c03",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "5c6978e2-17e4-47dc-9b6c-a06e55fb88d1",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 180],
      "parameters": {}
    },
    {
      "id": "7c80ad9c-72e7-4f4f-ac5c-510247909feb",
      "name": "Create private inbox notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 0],
      "parameters": {
        "method": "POST",
        "url": "http://api:4000/api/automation/tick",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"kind\":\"weekly\"}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "careloop-api-auth",
          "name": "CareLoop API automation"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Create private inbox notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual test": {
      "main": [
        [
          {
            "node": "Create private inbox notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Karachi",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "executionTimeout": 120
  },
  "tags": [],
  "versionId": "e30349c1-9963-4610-a23a-61c9bd6368f5"
}
